# Copy to .env (which git ignores) and fill in. `npm start` reads it automatically.

# Serve plain HTTP on this machine only; Tailscale (`tailscale serve --bg 8443`) adds HTTPS in front.
RDRIVE_HTTP=1
HOST=127.0.0.1
PORT=8443
RDRIVE_TRUST_PROXY=1

# The one address you use for rdrive on every device.
RDRIVE_PUBLIC_URL=https://your-machine.your-tailnet.ts.net

# From your GitHub OAuth App (github.com/settings/developers). Keep the secret private.
RDRIVE_GITHUB_CLIENT_ID=
RDRIVE_GITHUB_CLIENT_SECRET=
