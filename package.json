{
  "name": "rdrive",
  "version": "0.5.3",
  "description": "Self-hosted, open source file drive. Run it on one machine, reach it securely from your other devices.",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "adduser": "node server.js adduser",
    "adduser-github": "node server.js adduser-github",
    "link-github": "node server.js link-github",
    "unlink-github": "node server.js unlink-github",
    "passwd": "node server.js passwd",
    "set-owner": "node server.js set-owner",
    "add-token": "node server.js add-token",
    "mcp": "node mcp.js",
    "deluser": "node server.js deluser",
    "users": "node server.js users",
    "test": "node --test test/*.test.js",
    "vendor": "node scripts/vendor.js",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "drive",
    "self-hosted",
    "file-sharing",
    "google-drive-alternative",
    "sso"
  ],
  "homepage": "https://github.com/CloudCorpRecords/rdrive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CloudCorpRecords/rdrive.git"
  },
  "bugs": {
    "url": "https://github.com/CloudCorpRecords/rdrive/issues"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "linkedom": "^0.18.14",
    "mammoth": "^1.13.0",
    "qrcode-generator": "^2.0.4"
  }
}
