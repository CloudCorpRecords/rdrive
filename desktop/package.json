{
  "name": "rdrive-desktop",
  "productName": "rdrive",
  "version": "0.3.0",
  "description": "Desktop app for rdrive: host your drive on this computer, or open a drive hosted elsewhere.",
  "main": "main.js",
  "author": "rdrive contributors",
  "license": "MIT",
  "private": true,
  "repository": "github:CloudCorpRecords/rdrive",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "icons": "node scripts/make-icons.js"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.cloudcorprecords.rdrive",
    "productName": "rdrive",
    "publish": null,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "settings.js",
      "setup.html",
      "setup.js",
      "setup.css",
      "assets/**"
    ],
    "extraResources": [
      { "from": "../server.js", "to": "server/server.js" },
      { "from": "../package.json", "to": "server/package.json" },
      { "from": "../lib", "to": "server/lib" },
      { "from": "../public", "to": "server/public" },
      { "from": "../node_modules/selfsigned", "to": "server/node_modules/selfsigned" },
      { "from": "../node_modules/node-forge", "to": "server/node_modules/node-forge" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "build/icon.png"
    }
  }
}
