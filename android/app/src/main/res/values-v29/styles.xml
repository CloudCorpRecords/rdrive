<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows the phone's light/dark setting on Android 10+. -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <!-- White title and icons on the blue app bar. -->
        <item name="android:actionBarTheme">@android:style/ThemeOverlay.Material.Dark.ActionBar</item>
    </style>
</resources>
