<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, with the system's trusted certificates (Tailscale's are). No plain HTTP anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
